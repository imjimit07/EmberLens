# Application mode: development exposes /docs; production disables interactive API docs.
EMBERLENS_ENV=development

# Local development uses SQLite. Vercel production uses Supabase PostgreSQL.
EMBERLENS_DB=./data/emberlens.sqlite
# On Vercel, set this to Supabase > Connect > Transaction pooler (port 6543).
# Keep the full connection string private; never put it in frontend JavaScript.
SUPABASE_DB_URL=
# Required for Vercel CSV uploads up to 50 MB. Keep this service-role key server-side only.
# Create the private bucket by applying supabase/migrations/20261115000100_emberlens_csv_storage.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional NASA FIRMS MAP_KEY. Keep this on the backend only.
# Request one at https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# Required in production (at least 24 characters) before CSV uploads, API retrieval or backfill are enabled.
# Serve the app behind HTTPS; never commit the actual secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EMBERLENS_ADMIN_TOKEN=


# Optional NASA Space Apps Global Offer: Meteomatics Weather API.
# Claim the offer through your logged-in Space Apps account, then add credentials here.
# Never expose these values in frontend JavaScript or commit real credentials.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Microsoft Planetary Computer's public STAC/Data APIs are used without credentials.
